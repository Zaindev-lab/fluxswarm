# Docker build context exclusions (repo root context).
# Keep: backend/, deploy/docker/hermes-home/,
#       deploy/docker/Dockerfile, entrypoint.sh, hermes-minimal-requirements.txt
# Hermes Agent source is fetched from the pinned upstream commit at build time
# (see deploy/docker/Dockerfile), NOT vendored in this repo.
# Exclude: git, secrets, runtime app data, backups, heavy/dev artifacts.

.git
.gitignore
fluxswarm-docs.zip

# Never include the (removed) vendored Hermes source in the build context.
deploy/docker/hermes-src

# FluxSwarm runtime app data is provided by a volume, never baked into images.
backend/data

# Dev/CI artifacts.
.gitignore
.pytest_cache
.coverage
__pycache__
*.pyc
*.pyo
pyerr.txt
backups
audit/*.jsonl

# Not part of the self-contained build path.
*.log
