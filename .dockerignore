# Docker build context exclusions (repo root context).
# Keep: backend/, deploy/docker/hermes-src/, deploy/docker/hermes-home/,
#       deploy/docker/Dockerfile, entrypoint.sh, hermes-minimal-requirements.txt
# Exclude: git, secrets, runtime app data, backups, heavy/dev artifacts.

.git
.gitignore
fluxswarm-docs.zip

# FluxSwarm runtime app data is provided by a volume, never baked into images.
backend/data

# Dev/CI artifacts.
.gitignore
.pytest_cache
.coverage
__pycache__
*.pyc
*.pyo
pyerr.txt
backups
audit/*.jsonl

# Not part of the self-contained build path.
*.log
