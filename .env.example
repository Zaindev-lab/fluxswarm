# FluxSwarm backend — environment configuration (copy to .env and fill in).
# DO NOT commit the real values. These two secrets are REQUIRED in production;
# the app REFUSES to start without them (no ephemeral secrets in production).

# --- Demo/development mode (dev-only alternative to the two secrets) ---
# Set to 1 ONLY for the local sandbox / demo deployment. It permits
# ephemeral/generated Fernet+JWT secrets and demo-mode KMS file keys. NEVER set
# it on a real production deployment. The demo surface picks its (free-tier)
# provider from the provider pool at launch time — no operator default is
# required for the demo.
# FLUXSWARM_DEMO_MODE=1

# --- Auth / encryption (REQUIRED in prod) ---
# JWT signing secret for auth tokens. Generate:  python -c "import secrets;print(secrets.token_urlsafe(48))"
FLUXSWARM_JWT_SECRET=
# Fernet key: fallback KEK for BYOK envelopes; also the legacy vault cipher key.
# Generate:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FLUXSWARM_FERNET_KEY=

# --- KMS envelope encryption for BYOK keys (Phase 3) ---
# vault.py seals every provider key with a fresh AES-256-GCM DEK wrapped by this
# KEK. Backend selected by FLUXSWARM_KMS_BACKEND (default "file" — single-node
# only; prefer a real KMS in production):
#   file            -> FLUXSWARM_KMS_FILE_KEY (strong random passphrase)
#   aws_kms         -> FLUXSWARM_AWS_KMS_KEY_ID + AWS credentials (boto3)
#   azure_keyvault  -> FLUXSWARM_AZURE_KEYVAULT_URL + FLUXSWARM_AZURE_KEYVAULT_KEY
#   hashicorp_vault -> FLUXSWARM_VAULT_ADDR + FLUXSWARM_VAULT_TOKEN + FLUXSWARM_VAULT_TRANSIT_KEY
FLUXSWARM_KMS_BACKEND=file
FLUXSWARM_KMS_FILE_KEY=
# FLUXSWARM_AWS_KMS_KEY_ID=
# FLUXSWARM_AZURE_KEYVAULT_URL=
# FLUXSWARM_AZURE_KEYVAULT_KEY=
# FLUXSWARM_VAULT_ADDR=
# FLUXSWARM_VAULT_TOKEN=
# FLUXSWARM_VAULT_TRANSIT_KEY=

# --- Production provider (REQUIRED in prod; paid only, no free fallback) ---
# envguard refuses production startup until at least one PAID provider key is
# set: ANTHROPIC_API_KEY, OPENAI_API_KEY or GOOGLE_API_KEY. The squad runtime
# used when a user provides no BYOK key comes from FLUXSWARM_DEFAULT_PROVIDER +
# FLUXSWARM_DEFAULT_MODEL below. Never set a "free"/default model here — the
# demo surface resolves free-tier providers via provider_pool at launch time.
FLUXSWARM_DEFAULT_PROVIDER=
# Model pinned for the default provider (required when FLUXSWARM_DEFAULT_PROVIDER
# is set; may also satisfy a BYOK provider that has no per-provider override).
FLUXSWARM_DEFAULT_MODEL=
# Optional per-provider model overrides, e.g. FLUXSWARM_MODEL_ANTHROPIC=
#   FLUXSWARM_MODEL_ANTHROPIC=
#   FLUXSWARM_MODEL_OPENAI=
#   FLUXSWARM_MODEL_GEMINI=
#   FLUXSWARM_MODEL_KIMI=
#   FLUXSWARM_MODEL_OPENROUTER=

# --- Redis (optional; enables multi-worker rate limiting) ---
# Used by ratelimit.py when set; falls back to in-process memory otherwise.
# For the 0$/month hosting plan use Upstash (256MB free) and set the REST URL:
#   REDIS_URL=https://user:pass@my-db.upstash.io  (or prefer FLUXSWARM_REDIS_URL)
REDIS_URL=redis://redis:6379/0
FLUXSWARM_REDIS_URL=redis://redis:6379/0

# --- PostgreSQL (REQUIRED in prod; replaces SQLite) ---
# Production startup refuses to launch without this URL. Migration + schema are
# managed by Alembic (backend/alembic), applied automatically by db_postgres.init_db().
# SQLite (data/users.db) data can be imported with scripts/migrate_sqlite_to_postgres.py.
# Generate a connection string, e.g.:
#   postgresql://fluxswarm:PASSWORD@db-host:5432/fluxswarm
# Neon (0$/month, scale-to-zero) example — note sslmode=require:
#   postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/fluxswarm?sslmode=require
FLUXSWARM_DATABASE_URL=
# Connection-pool sizing (asyncpg). Defaults: min 10 / max 50 / timeout 60s /
# reconnect reuse (max_queries 50k, idle lifetime 300s).
FLUXSWARM_DB_POOL_MIN=10
FLUXSWARM_DB_POOL_MAX=50
FLUXSWARM_DB_TIMEOUT_S=60
FLUXSWARM_DB_POOL_MAX_QUERIES=50000
FLUXSWARM_DB_POOL_IDLE_LIFETIME_S=300.0

# --- Session 3: swarm memory budget & reaper tuning ---
# MAX_IN_PROGRESS = clamp(FLUXSWARM_MEM_TOTAL_MB / MEMORY_GUARD_MB_PER_WORKER, 2..16)
# (hermes_client.MAX_IN_PROGRESS) is the backend default max_spawn ceiling and the
# reaper's default. Keep FLUXSWARM_MEM_TOTAL_MB in sync with docker compose
# `deploy.resources.limits.memory`. 8GB/384MB -> 21 -> capped 16.
FLUXSWARM_MEM_TOTAL_MB=8192
MEMORY_GUARD_MB_PER_WORKER=384
FLUXSWARM_REAPER_ENABLED=1
FLUXSWARM_REAPER_INTERVAL_S=30
FLUXSWARM_REAPER_MAX_SPAWN=16
FLUXSWARM_REAPER_ERROR_BACKOFF_S=300
# Demo lifecycle: auto-seal a flux-demo-* board still running after 10 min;
# delete sealed demo workspaces after 24h.
FLUXSWARM_DEMO_MAX_RUNTIME_S=600
FLUXSWARM_DEMO_WORKSPACE_TTL_S=86400

# --- Monitoring / alerting ---
# Optional webhook (Slack-compatible {"text", "priority"}) pinged when /health
# reports not-ok; throttled to one alert per 5 minutes.
ALERT_WEBHOOK_URL=

# --- Audit log rotation ---
# audit.jsonl rotates at 100MB, keeps 10 files, gzips anything older than 7 days.
FLUXSWARM_AUDIT_MAX_MB=100
FLUXSWARM_AUDIT_MAX_FILES=10
FLUXSWARM_AUDIT_GZIP_AFTER_S=604800

# --- Billing (dev gate stays closed by default; returns 402) ---
# Set to 1 only after wiring Paddle keys below. Until then paid plans 402.
FLUXSWARM_PAYMENTS=0
FLUXSWARM_PAYMENT_PROVIDER=paddle

# --- Paddle (Merchant of Record) ---
# Paddle acts as the seller of record: it handles global sales tax / VAT and
# remittance, which is why it satisfies most cross-border compliance work.
# Create a Sandbox account first, add price ids, register a webhook pointing to
#   https://<your-domain>/api/payments/webhook  (event: transaction.completed / refunded)
# then paste the Sandbox secret; promote the LIVE values only after a sandbox test.
# PADDLE_API_BASE=https://api.paddle.com            # sandbox: https://sandbox-api.paddle.com
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Client-side token for our /checkout Paddle.js page
# (Dashboard > Developer Tools > Authentication > Client-side tokens).
PADDLE_CLIENT_TOKEN=
# One price id per paid plan (from Paddle Catalog). Key = plain plan slug.
PADDLE_PRICE_STARTER=
PADDLE_PRICE_PRO=
PADDLE_PRICE_SCALE=
# Optional $9/10-credit Top-up refill pack (adds credits without changing tier).
PADDLE_PRICE_TOPUP=

# --- Transactional email (optional; no-op until set) ---
# Resend API key + sender. Without it the app runs but sends no welcome /
# credit-depletion emails.
# FLUXSWARM_RESEND_API_KEY=
# FLUXSWARM_MAIL_FROM=FluxSwarm <onboarding@resend.dev>

# --- Privacy-friendly analytics (optional Plausible; off until set) ---
# Your Plausible domain, e.g. "app.fluxswarm.ai". The snippet is only emitted
# when set (CSP already allows plausible.io).
# FLUXSWARM_ANALYTICS_DOMAIN=

# Public URL used in checkout redirects / callbacks.
FLUXSWARM_PUBLIC_BASE_URL=https://app.fluxswarm.ai

# --- In-app support assistant (hybrid) ---
# The rule-based knowledge engine answers pricing/credits/BYOK/refunds/etc with
# zero cost. For questions the rules can't answer, an optional OpenAI-compatible
# endpoint can reply (system prompt is a strict product handbook; it never
# receives user data beyond the chat message). Without these vars unknown
# questions escalate to the support email instead.
# FLUXSWARM_SUPPORT_AI_BASE=https://api.openai.com/v1
# FLUXSWARM_SUPPORT_AI_MODEL=gpt-4o-mini
# FLUXSWARM_SUPPORT_AI_KEY=

# Contact email shown on the privacy / terms pages.
FLUXSWARM_CONTACT_EMAIL=support@fluxswarm.ai

# --- Operating entity (shown on /privacy, /terms + English variants) ---
# Optional but recommended before launch: disclose the legal entity that operates
# the service. Rendered as the "Operating entity" block on all four legal pages.
# The audit-log retention disclosure (CCPA) and Paddle MoR statement are always shown.
# FLUXSWARM_LEGAL_ENTITY=Acme SaaS LLC
# FLUXSWARM_LEGAL_REGISTRY_NO=123456789
# FLUXSWARM_LEGAL_TAX_ID=US-XX-XXXXXXXX
# FLUXSWARM_LEGAL_ADDRESS=100 Market St, San Francisco, CA 94105, USA
# FLUXSWARM_LEGAL_PHONE=+1-555-0100

# --- CORS (strict allow-list; NEVER use "*") ---
# Comma-separated list of exact frontend origins (https recommended).
FLUXSWARM_CORS_ORIGINS=https://app.fluxswarm.ai

# --- Reverse proxy trust (for X-Forwarded-For) ---
# Comma-separated IPs/CIDRs of proxies allowed to set X-Forwarded-For.
# The Caddy/Nginx host(s) MUST be listed here or client IPs are untrusted.
FLUXSWARM_TRUSTED_PROXIES=127.0.0.1,::1

# --- Hermes bridge (optional override) ---
# Path to the Hermes CLI the backend drives to launch squads.
# FLUXSWARM_HERMES_BIN=/app/hermes/bin/hermes

# --- Phase 2: Hermes Docker sandbox (default OFF) ---
# Set to 1 to dispatch every hermes kanban command inside the hardened
# runner container (fluxswarm/hermes-runner:latest) instead of the host.
# FLUXSWARM_DOCKER_DISPATCH=0
# FLUXSWARM_RUNNER_IMAGE=fluxswarm/hermes-runner:latest
# FLUXSWARM_DISPATCH_TIMEOUT_S=900
# FLUXSWARM_DISPATCH_KILL_GRACE_S=30
# FLUXSWARM_DOCKER_RM_RETRIES=3
