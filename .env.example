# FluxSwarm backend — environment configuration (copy to .env and fill in).
# DO NOT commit the real values. These three secrets are required in production
# and must be generated once, then kept secret.

# --- Auth / encryption (REQUIRED in prod) ---
# JWT signing secret for auth tokens. Generate:  python -c "import secrets;print(secrets.token_urlsafe(48))"
FLUXSWARM_JWT_SECRET=
# Fernet key for encrypting user-supplied BYOK provider keys at rest.
# Generate:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FLUXSWARM_FERNET_KEY=

# --- Redis (optional; enables multi-worker rate limiting) ---
# Used by ratelimit.py when set; falls back to in-process memory otherwise.
REDIS_URL=redis://redis:6379/0
FLUXSWARM_REDIS_URL=redis://redis:6379/0

# --- Billing (dev gate stays closed by default; returns 402) ---
# Set to 1 only after wiring Paddle keys below. Until then paid plans 402.
FLUXSWARM_PAYMENTS=0
FLUXSWARM_PAYMENT_PROVIDER=paddle

# --- Paddle (Merchant of Record) ---
# Paddle acts as the seller of record: it handles global sales tax / VAT and
# remittance, which is why it satisfies most cross-border compliance work.
# Create a Sandbox account first, add price ids, register a webhook pointing to
#   https://<your-domain>/api/payments/webhook  (event: transaction.completed / refunded)
# then paste the Sandbox secret; promote the LIVE values only after a sandbox test.
# PADDLE_API_BASE=https://api.paddle.com            # sandbox: https://sandbox-api.paddle.com
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Client-side token for our /checkout Paddle.js page
# (Dashboard > Developer Tools > Authentication > Client-side tokens).
PADDLE_CLIENT_TOKEN=
# One price id per paid plan (from Paddle Catalog). Key = plain plan slug.
PADDLE_PRICE_STARTER=
PADDLE_PRICE_PRO=
PADDLE_PRICE_SCALE=

# Public URL used in checkout redirects / callbacks.
FLUXSWARM_PUBLIC_BASE_URL=https://app.fluxswarm.ai

# Contact email shown on the privacy / terms pages.
FLUXSWARM_CONTACT_EMAIL=support@fluxswarm.ai

# --- Operating entity (shown on /privacy, /terms + English variants) ---
# Optional but recommended before launch: disclose the legal entity that operates
# the service. Rendered as the "Operating entity" block on all four legal pages.
# The audit-log retention disclosure (CCPA) and Paddle MoR statement are always shown.
# FLUXSWARM_LEGAL_ENTITY=Acme SaaS LLC
# FLUXSWARM_LEGAL_REGISTRY_NO=123456789
# FLUXSWARM_LEGAL_TAX_ID=US-XX-XXXXXXXX
# FLUXSWARM_LEGAL_ADDRESS=100 Market St, San Francisco, CA 94105, USA

# --- CORS (strict allow-list; NEVER use "*") ---
# Comma-separated list of exact frontend origins (https recommended).
FLUXSWARM_CORS_ORIGINS=https://app.fluxswarm.ai

# --- Reverse proxy trust (for X-Forwarded-For) ---
# Comma-separated IPs/CIDRs of proxies allowed to set X-Forwarded-For.
# The Caddy/Nginx host(s) MUST be listed here or client IPs are untrusted.
FLUXSWARM_TRUSTED_PROXIES=127.0.0.1,::1

# --- Hermes bridge (optional override) ---
# Path to the Hermes CLI the backend drives to launch squads.
# FLUXSWARM_HERMES_BIN=/app/hermes/bin/hermes
