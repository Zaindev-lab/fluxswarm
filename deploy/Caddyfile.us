# Live launch companion for Caddy that MUST sit on the same host as the
# fluxswarm container so X-Forwarded-For from 127.0.0.1 is trustworthy.
#
# --- THIS FILE IS GENERATED by deploy/bootstrap.sh — edit bootstrap.sh instead.

{
    email __ADMIN_EMAIL__
}

__DOMAIN__ {
    encode zstd gzip

    request_body {
        max_size 1MB
    }

    reverse_proxy 127.0.0.1:8787 {
        health_uri /health
        health_interval 10s
        health_timeout 3s
        header_up X-Forwarded-For {remote_host}
        header_up X-Real-IP {remote_host}
    }
}